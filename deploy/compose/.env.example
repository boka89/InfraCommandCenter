# ---- ICC (see docs/configuration.md for every variable)
ICC_PUBLIC_URL=http://localhost:8080
# Plain HTTP without a TLS proxy in front: cookies must not be "Secure"
ICC_COOKIE_SECURE=false
ICC_AUTH_PROVIDERS=local
ICC_ADMIN_USER=admin
ICC_ADMIN_PASSWORD=change-me

# Configuration repository (empty = local repo with the example config)
ICC_CONFIG_REPO=
ICC_CONFIG_BRANCH=main
ICC_CONFIG_PATH=
# ICC_GIT_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n..."   or   ICC_GIT_TOKEN=...

# AI operator: Hermes Agent API server (API_SERVER_ENABLED=true, API_SERVER_HOST=0.0.0.0, API_SERVER_KEY=...)
ICC_HERMES_URL=
ICC_HERMES_API_KEY=

# Bring your own monitoring instead of the bundled VictoriaMetrics:
# ICC_METRICS_URL=http://prometheus.example.lan:9090
# ICC_GRAFANA_URL=https://grafana.example.com

# Vaultwarden profile
VAULTWARDEN_DOMAIN=
VAULTWARDEN_ADMIN_TOKEN=
